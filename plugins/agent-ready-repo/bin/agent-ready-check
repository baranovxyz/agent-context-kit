#!/usr/bin/env python3
"""Check common agent-ready repository memory issues."""

from __future__ import annotations

import re
import sys
import json
import argparse
from pathlib import Path


ROOT = Path.cwd()

DESCRIPTION_BLOCK_SCALAR = re.compile(r"^description:\s*[|>]", re.MULTILINE)
UNSUPPORTED_TRIGGER_FIELD = re.compile(r"^(when_to_use|when-to-use):", re.MULTILINE)
BAD_FRONTMATTER_DESCRIPTION = re.compile(
    r"</?[A-Za-z][A-Za-z0-9_-]*(?:\s[^>]*)?>|```|^\s*[-*]\s+|\bExamples?:",
    re.IGNORECASE | re.MULTILINE,
)

DEFAULT_MAX_AGENTS_MD_BYTES = 24000
DEFAULT_MAX_LINE_CHARS = 1500


def read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return path.read_text(errors="ignore")


def frontmatter_body(text: str) -> str:
    if not text.startswith("---\n"):
        return ""
    end = text.find("\n---", 4)
    if end == -1:
        return ""
    return text[4:end]


def frontmatter(text: str) -> dict[str, str]:
    body = frontmatter_body(text)
    if not body:
        return {}
    result: dict[str, str] = {}
    for line in body.splitlines():
        if ":" not in line or line.startswith(" "):
            continue
        key, value = line.split(":", 1)
        result[key.strip()] = value.strip().strip('"')
    return result


def add_issue(issues: list[dict[str, str]], level: str, message: str) -> None:
    issues.append({"level": level, "message": message})


def check_description_frontmatter(
    issues: list[dict[str, str]], path: Path, meta: dict[str, str], body: str
) -> None:
    relative_path = path.relative_to(ROOT)
    description = meta.get("description", "")

    if UNSUPPORTED_TRIGGER_FIELD.search(body):
        add_issue(issues, "WARN", f"{relative_path} uses unsupported when_to_use metadata")
    if DESCRIPTION_BLOCK_SCALAR.search(body):
        add_issue(issues, "WARN", f"{relative_path} uses a multiline description")
    if BAD_FRONTMATTER_DESCRIPTION.search(body):
        add_issue(issues, "WARN", f"{relative_path} puts examples, tags, or Markdown in frontmatter")
    if description and len(description) > 240:
        add_issue(issues, "WARN", f"{relative_path} description is too long; keep it concise and one-line")


def check_agents_md(
    issues: list[dict[str, str]],
    max_bytes: int = DEFAULT_MAX_AGENTS_MD_BYTES,
    max_line_chars: int = DEFAULT_MAX_LINE_CHARS,
) -> None:
    path = ROOT / "AGENTS.md"
    if not path.exists():
        add_issue(issues, "WARN", "AGENTS.md is missing")
        return

    text = read(path)
    lines = text.splitlines()
    size = len(text.encode("utf-8"))
    if size > max_bytes:
        add_issue(
            issues,
            "WARN",
            f"AGENTS.md is {size} bytes; budget is {max_bytes} — it loads every "
            f"session, move detail to a referenced doc",
        )
    if len(lines) > 400:
        add_issue(issues, "WARN", f"AGENTS.md is {len(lines)} lines; audit above 400")

    in_fence = False
    for number, line in enumerate(lines, start=1):
        stripped = line.lstrip()
        if stripped.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence or stripped.startswith("|"):
            continue
        # len() counts code points, not bytes — intentional; the cap targets
        # readability of unbounded one-liners, not byte cost.
        if len(line) > max_line_chars:
            add_issue(
                issues,
                "WARN",
                f"AGENTS.md line {number} is {len(line)} chars; over the "
                f"{max_line_chars}-char cap — move detail to a referenced doc",
            )

    if re.search(r"(TODO:|TK:|\[placeholder\])", text, re.IGNORECASE):
        add_issue(issues, "WARN", "AGENTS.md contains unresolved placeholder markers")

    optional_host_files = {"AGENTS.md", "CLAUDE.md", "CLAUDE.local.md", "GEMINI.md"}
    for match in re.finditer(r"`([^`]+\.(?:md|mdc))`", text):
        candidate = match.group(1)
        if candidate.startswith(("http://", "https://")) or "*" in candidate:
            continue
        if "<" in candidate or ">" in candidate:
            continue  # illustrative placeholder (e.g. docs/<name>.md), not a real path
        if "/" not in candidate:
            continue  # bare filename in prose, not a resolvable doc link
        if candidate.startswith("@") or candidate in optional_host_files:
            continue
        if not (ROOT / candidate).exists():
            add_issue(issues, "WARN", f"AGENTS.md references missing file: {candidate}")


def check_claude_md(issues: list[dict[str, str]]) -> None:
    path = ROOT / "CLAUDE.md"
    if not path.exists():
        return
    text = read(path)
    if "AGENTS.md" not in text:
        add_issue(issues, "WARN", "CLAUDE.md exists but does not reference AGENTS.md")


SKIP_DIR_NAMES = {
    ".git", "node_modules", "dist", "build", "out", ".next", ".turbo",
    ".cache", ".pnpm-store", "coverage", ".venv", "venv", "__pycache__",
    ".claude", ".agents",
}


def find_agents_md_files() -> list[Path]:
    """Walk the repo and return every AGENTS.md outside ignored trees.

    The skill mandates a sibling CLAUDE.md shim next to every AGENTS.md so
    Claude Code (which does not auto-load AGENTS.md) picks up package-level
    guidance via the host import.
    """
    found: list[Path] = []
    stack: list[Path] = [ROOT]
    while stack:
        directory = stack.pop()
        try:
            entries = list(directory.iterdir())
        except (PermissionError, FileNotFoundError):
            continue
        for entry in entries:
            if entry.is_symlink():
                continue
            if entry.is_dir():
                if entry.name in SKIP_DIR_NAMES:
                    continue
                stack.append(entry)
            elif entry.is_file() and entry.name == "AGENTS.md":
                found.append(entry)
    return found


def check_claude_md_shims(issues: list[dict[str, str]]) -> None:
    for agents_path in find_agents_md_files():
        rel_agents = agents_path.relative_to(ROOT)
        shim = agents_path.parent / "CLAUDE.md"
        rel_shim = shim.relative_to(ROOT)
        if not shim.exists():
            add_issue(
                issues,
                "WARN",
                f"{rel_agents} has no sibling CLAUDE.md shim "
                f"(create {rel_shim} containing `@AGENTS.md`)",
            )
            continue
        shim_text = read(shim).strip()
        if "@AGENTS.md" not in shim_text and "AGENTS.md" not in shim_text:
            add_issue(
                issues,
                "WARN",
                f"{rel_shim} does not import its sibling AGENTS.md "
                f"(expected `@AGENTS.md`)",
            )


def skill_files() -> list[Path]:
    roots = [ROOT / ".claude" / "skills", ROOT / ".agents" / "skills", ROOT / "skills"]
    files: list[Path] = []
    for root in roots:
        if root.exists():
            files.extend(root.glob("*/SKILL.md"))
    return files


def check_skills(issues: list[dict[str, str]]) -> None:
    vague = re.compile(r"\b(help|helps|useful|stuff|things|general)\b", re.IGNORECASE)
    for path in skill_files():
        text = read(path)
        body = frontmatter_body(text)
        meta = frontmatter(text)
        name = meta.get("name")
        description = meta.get("description", "")
        check_description_frontmatter(issues, path, meta, body)
        if not name or not description:
            add_issue(issues, "WARN", f"{path.relative_to(ROOT)} missing name or description frontmatter")
            continue
        if len(description) < 40 or vague.search(description):
            add_issue(issues, "WARN", f"{path.relative_to(ROOT)} has a weak or vague description")


PLUGIN_NAME = "agent-ready-repo"

MARKETPLACE_MANIFESTS = [
    Path(".claude-plugin/marketplace.json"),
    Path(".cursor-plugin/marketplace.json"),
    Path(".agents/plugins/marketplace.json"),
]

PLUGIN_MANIFESTS = [
    Path("plugins") / PLUGIN_NAME / ".claude-plugin" / "plugin.json",
    Path("plugins") / PLUGIN_NAME / ".cursor-plugin" / "plugin.json",
    Path("plugins") / PLUGIN_NAME / ".codex-plugin" / "plugin.json",
]


def load_json(path: Path) -> dict | None:
    try:
        return json.loads(read(path))
    except (json.JSONDecodeError, FileNotFoundError):
        return None


def marketplace_version(data: dict) -> str | None:
    metadata = data.get("metadata") if isinstance(data, dict) else None
    if isinstance(metadata, dict) and "version" in metadata:
        return str(metadata["version"])
    if isinstance(data, dict) and "version" in data:
        return str(data["version"])
    return None


def marketplace_plugin_version(data: dict, plugin_name: str) -> str | None:
    plugins = data.get("plugins") if isinstance(data, dict) else None
    if not isinstance(plugins, list):
        return None
    for entry in plugins:
        if isinstance(entry, dict) and entry.get("name") == plugin_name and "version" in entry:
            return str(entry["version"])
    return None


def check_manifest_versions(issues: list[dict[str, str]]) -> None:
    versions: dict[str, str] = {}

    for relative in MARKETPLACE_MANIFESTS:
        path = ROOT / relative
        if not path.exists():
            continue
        data = load_json(path)
        if data is None:
            add_issue(issues, "WARN", f"{relative} is not valid JSON")
            continue
        top = marketplace_version(data)
        if top:
            versions[str(relative)] = top
        plugin_version = marketplace_plugin_version(data, PLUGIN_NAME)
        if plugin_version:
            versions[f"{relative}#plugins[{PLUGIN_NAME}]"] = plugin_version

    for relative in PLUGIN_MANIFESTS:
        path = ROOT / relative
        if not path.exists():
            continue
        data = load_json(path)
        if data is None:
            add_issue(issues, "WARN", f"{relative} is not valid JSON")
            continue
        version = data.get("version") if isinstance(data, dict) else None
        if version:
            versions[str(relative)] = str(version)

    if len({v for v in versions.values()}) > 1:
        joined = ", ".join(f"{k}={v}" for k, v in sorted(versions.items()))
        add_issue(issues, "WARN", f"plugin manifest versions disagree: {joined}")


def agent_files() -> list[Path]:
    roots = [ROOT / ".claude" / "agents", ROOT / "agents"]
    files: list[Path] = []
    for root in roots:
        if root.exists():
            files.extend(root.glob("*.md"))
    return files


def check_agents(issues: list[dict[str, str]]) -> None:
    for path in agent_files():
        text = read(path)
        body = frontmatter_body(text)
        meta = frontmatter(text)
        check_description_frontmatter(issues, path, meta, body)
        if not meta.get("name") or not meta.get("description"):
            add_issue(issues, "WARN", f"{path.relative_to(ROOT)} missing name or description frontmatter")


def emit(issues: list[dict[str, str]], json_output: bool) -> None:
    if json_output:
        print(json.dumps({"ok": not issues, "issue_count": len(issues), "issues": issues}, indent=2))
        return

    for issue in issues:
        print(f"{issue['level']}: {issue['message']}")

    if issues:
        print(f"SUMMARY: {len(issues)} issue(s) found")
    else:
        print("SUMMARY: No common agent-ready issues found")


def main() -> int:
    parser = argparse.ArgumentParser(description="Check common agent-ready repository memory issues.")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON output.")
    parser.add_argument("--root", help="Repository root to check (default: current directory).")
    parser.add_argument("--only", help="Comma-separated check names to run (default: all).")
    parser.add_argument(
        "--max-agents-md-bytes",
        type=int,
        default=DEFAULT_MAX_AGENTS_MD_BYTES,
        help=f"AGENTS.md byte budget (default: {DEFAULT_MAX_AGENTS_MD_BYTES}).",
    )
    parser.add_argument(
        "--max-line-chars",
        type=int,
        default=DEFAULT_MAX_LINE_CHARS,
        help=f"Per-line character cap for AGENTS.md (default: {DEFAULT_MAX_LINE_CHARS}).",
    )
    args = parser.parse_args()

    if args.root:
        global ROOT
        ROOT = Path(args.root).resolve()

    checks = {
        "agents-md": lambda i: check_agents_md(i, args.max_agents_md_bytes, args.max_line_chars),
        "claude-md": check_claude_md,
        "claude-md-shims": check_claude_md_shims,
        "skills": check_skills,
        "agents": check_agents,
        "manifest-versions": check_manifest_versions,
    }
    if args.only:
        selected = [name.strip() for name in args.only.split(",") if name.strip()]
        unknown = [name for name in selected if name not in checks]
        if unknown:
            parser.error(f"unknown check name(s): {', '.join(unknown)}; valid: {', '.join(checks)}")
    else:
        selected = list(checks)

    issues: list[dict[str, str]] = []
    for name in selected:
        checks[name](issues)

    emit(issues, args.json)
    return 1 if issues else 0


if __name__ == "__main__":
    sys.exit(main())
